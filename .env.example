# Copy to .env.local. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

# --- Required for any run ---
SESSION_SECRET=            # 32+ random chars; signs staff session cookies
STAFF_PASSCODE=            # shared demo passcode for /staff

# --- Database ---
# Supabase Postgres connection string (Settings -> Database -> Connection string -> Transaction pooler, port 6543).
# If unset AND not on Vercel, the app uses a local PGlite database in .data/pglite (labelled LOCAL DEV DATABASE).
DATABASE_URL=

# --- AI providers (server-side only) ---
ANTHROPIC_API_KEY=
PARCHI_MODEL=claude-opus-5-5
PARCHI_EFFORT=medium
GOOGLE_VISION_API_KEY=
SARVAM_API_KEY=
